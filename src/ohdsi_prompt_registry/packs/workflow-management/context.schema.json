{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "workflow_id",
    "phase",
    "resolved_decisions",
    "pending_requests",
    "artifacts",
    "packs"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "phase": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "resolved_decisions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "revision",
          "value",
          "domain_status"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "value": {},
          "domain_status": {
            "enum": [
              "pending",
              "accepted",
              "rejected"
            ]
          }
        }
      }
    },
    "pending_requests": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_key",
          "revision",
          "required_for"
        ],
        "properties": {
          "decision_key": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "required_for": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "depends_on"
        ],
        "properties": {
          "status": {
            "enum": [
              "draft",
              "ready",
              "stale"
            ]
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "packs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "content_id"
        ],
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "content_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
